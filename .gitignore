# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cargo workspace build output (the workspace root is now the repo root, so the
# target dir moved up out of src-tauri/)
/target

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SocketSweep custom ignores
engine/daemon
output.json

# Host binaries fetched by `npm run setup` — never commit these.
# adb is ~18MB per platform and CI downloads a platform-correct copy anyway.
src-tauri/bin/adb
src-tauri/bin/adb.exe
src-tauri/bin/AdbWinApi.dll
src-tauri/bin/AdbWinUsbApi.dll

# Device daemons (phone arm64, emulator x86_64), cross-compiled by
# `npm run build:daemon` (needs an Android NDK). Declared bundle resources, so
# build them before `tauri build` or clippy.
src-tauri/bin/daemon-arm64
src-tauri/bin/daemon-x86_64
src-tauri/bin/daemon-arm64.gz
src-tauri/bin/daemon-x86_64.gz

# Exclude local JSON test dumps
out*.json

